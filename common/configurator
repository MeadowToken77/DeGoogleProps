# configurator for DeGoogleProps
#! /system/bin/sh
MODDIR=${0%/*}
config=$MODDIR/settings.conf
CURRENT_SELECTION=""
WEBVIEW_UPDATE=false

configuration_type(){
    selector 'configure webview' 'configure private dns' 'configure ntp' 'configure captive portal' update
    case $CURRENT_SELECTION in
    'configure webview')
      configure_webview
    ;;
    'configure private dns')
      configure_private_dns
    ;;
    'configure ntp')
      configure_ntp
    ;;
    'configure captive portal')
      configure_captive_portal
    ;;
    update)
      WEBVIEW_UPDATE=true
      update
      exit 0
    ;;
    esac
  }

configure_webview(){
    WVS=""
    while true; do
      selector Vanadium Aosmium Cromite
      case "$CURRENT_SELECTION" in
        "Vanadium")
          if contains "vanadium" $WVS; then
            echo "Don't add the same webview twice"
          else
            WVS="$WVS vanadium"
          fi
        ;;
        "Aosmium")
          if contains "aosmium" $WVS; then
            echo "Don't add the same webview twice"
          else
            WVS="$WVS aosmium"
          fi
        ;;
        "Cromite")
          if contains "cromite" $WVS; then
            echo "Don't add the same webview twice"
          else
            WVS="$WVS cromite"
          fi
        ;;
      esac
      CURRENT_SELECTION=""
      echo "install additional webview?"
      echo "Vol + = Yes, Vol - = No"
      if ! chooseport; then
        WEBVIEW_UPDATE=true
        WVS=$(printf "%s" "$WVS" | sed 's/^ *//; s/  */ /g')
        # Write a plain space-separated string to config as WEBVIEW="item1 item2"
        sed -i.bak "s|^WEBVIEW=.*|WEBVIEW=\"$WVS\"|" "$config"
        return
      fi
    done
  }

contains() {
  target="$1"; shift
  for item in "$@"; do
    if [ "$item" = "$target" ]; then
      return 0
    fi
  done
  return 1
}

configure_private_dns(){
    selector Mullvad Quad9 Cloudflare custom
    case $CURRENT_SELECTION in
    "Mullvad")
      sed -i.bak 's/^PRIVATE_DNS=.*/PRIVATE_DNS=adblock.dns.mullvad.net/' $config
      CURRENT_SELECTION=""
    ;;
    "Quad9")
      sed -i.bak 's/^PRIVATE_DNS=.*/PRIVATE_DNS=dns.quad9.net/' $config
      CURRENT_SELECTION=""
    ;;
    "Cloudflare")
      sed -i.bak 's/^PRIVATE_DNS=.*/PRIVATE_DNS=one.one.one.one/' $config
      CURRENT_SELECTION=""
    ;;
    "custom")
      #TODO:create action for entering text
      echo "for custom entries, edit the line PRIVATE_DNS in $config ..."
      sleep 3
    ;;
    esac
  }

configure_ntp(){
    selector pool.ntp.org custom
    if [ "$CURRENT_SELECTION" == "pool.ntp.org" ]; then
      sed -i.bak 's|^NTP_SERVER=.*|NTP_SERVER=pool.ntp.org|' $config 
      CURRENT_SELECTION="" 
      return 0
    fi
    echo "custom entries are not yet supported in configurator :("
    echo "for custom entries, edit the lines CAPTIVE_PORTAL_HTTP_URL and CAPTIVE_PORTAL_HTTPS_URL in $config ..."
    sleep 3
  }
configure_captive_portal(){
    selector GrapheneOS /e/OS Kuketz custom off
    case $CURRENT_SELECTION in
    "GrapheneOS")
      sed -i.bak 's|^CAPTIVE_PORTAL_ENABLED=.*|CAPTIVE_PORTAL_ENABLED=1|' $config
      sed -i.bak 's|^CAPTIVE_PORTAL_HTTP=.*|CAPTIVE_PORTAL_HTTP=http://connectivitycheck.grapheneos.network/generate_204|' $config
      sed -i.bak 's|^CAPTIVE_PORTAL_HTTPS=.*|CAPTIVE_PORTAL_HTTPS=https://connectivitycheck.grapheneos.network/generate_204|' $config
      CURRENT_SELECTION=""
    ;;
    "/e/OS")
      sed -i.bak 's|^CAPTIVE_PORTAL_ENABLED=.*|CAPTIVE_PORTAL_ENABLED=1|' $config
      sed -i.bak 's|^CAPTIVE_PORTAL_HTTP=.*|CAPTIVE_PORTAL_HTTP=http://204.ecloud.global|' $config
      sed -i.bak 's|^CAPTIVE_PORTAL_HTTPS=.*|CAPTIVE_PORTAL_HTTPS=https://e.foundation/net_204|' $config
      CURRENT_SELECTION=""
    ;;
    "Kuketz")
      sed -i.bak 's|^CAPTIVE_PORTAL_ENABLED=.*|CAPTIVE_PORTAL_ENABLED=1|' $config
      sed -i.bak 's|^CAPTIVE_PORTAL_HTTP=.*|CAPTIVE_PORTAL_HTTP=http://captiveportal.kuketz.de|' $config
      sed -i.bak 's|^CAPTIVE_PORTAL_HTTPS=.*|CAPTIVE_PORTAL_HTTPS=https://captiveportal.kuketz.de|' $config
      CURRENT_SELECTION=""
    ;;
    "custom")
      echo "custom entries are not yet supported in configurator :("
      echo "for custom entries, edit the lines CAPTIVE_PORTAL_HTTP and CAPTIVE_PORTAL_HTTPS in $config ..."
      sleep 3
    ;;
    "off")
      sed -i.bak 's|^CAPTIVE_PORTAL_ENABLED=.*|CAPTIVE_PORTAL_ENABLED=0|' $config
      CURRENT_SELECTION=""
    ;;
    esac
  }

#TUI controls for select options
clear_screen() { printf "\033[2J\033[H"; }
hide_cursor() { printf "\033[?25l"; }
show_cursor() { printf "\033[?25h"; }
reset() { printf "\033[0m"; }

# selelction function for choices passed on as positional arguments (options in order)
selector() {
  set -- "$@"
  n=$#
  idx=0
  CURRENT_SELECTION=""
  # hide_cursor
  while true; do
    # clear_screen
    echo "Use Volume Up to select, Volume Down to move."
    echo
    i=0
    for item in "$@"; do
      if [ "$i" -eq "$idx" ]; then
        printf '  \033➜ %s\033\n' "$item"
      else
        printf '    %s\n' "$item"
      fi
      i=$((i + 1))
    done

    if chooseport 1; then
      sel_idx=0
      for item in "$@"; do
        if [ "$sel_idx" -eq "$idx" ]; then
          CURRENT_SELECTION="$item"
          break
        fi
        sel_idx=$((sel_idx + 1))
      done
      # show_cursor
      return 0
    else
      idx=$(( (idx + 1) % n ))
    fi
  done
}
# chooseport funtion using volume keys 
chooseport() {
  local delay=${1:-1}
  local tmp=$TMPDIR/events
  while true; do
    timeout "$delay" /system/bin/getevent -lqc 1 2>&1 > "$tmp" &
    sleep 0.1
    if grep -q 'KEY_VOLUMEUP *DOWN' "$tmp"; then
      return 0
    elif grep -q 'KEY_VOLUMEDOWN *DOWN' "$tmp"; then
      return 1
    fi
    # keep looping until key pressed
  done
}

update(){
    if [ "$WEBVIEW_UPDATE" = true ]; then
      echo "Installing or Updating Webview(s)..."
      . $config
      alias abort="echo $@ && sleep 3 && exit 1"
      MODPATH=$MODDIR
      API=$(getprop ro.build.version.sdk)
      arch=$(getprop ro.product.cpu.abi)
      case "$arch" in arm64*) arch="arm64" ;; esac
      ARCH=$arch
      echo "Selected Webviews to be installed: $WEBVIEW "
      [ -f "common/install.sh" ] && . "common/install.sh" $WEBVIEW
    fi
    echo "Applying values..."
    su -c sh service.sh
    sleep 2
  }

#======================================
#this is where the functions get called
#=====================================
configuration_type
update

