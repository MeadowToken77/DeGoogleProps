# configurator for DeGoogleProps
#! /system/bin/sh
config=/data/adb/modules/DeGoogleProps/settings.conf
CURRENT_SELECTION=""
WEBVIEW_UPDATE=false

configuration_type(){
    selector 'configure webview' 'configure private dns' 'configure ntp' 'configure captive portal' update
    case $CURRENT_SELECTION in
    'configure webiew')
      configure_webview
    ;;
    'configure private dns')
      configure_private_dns
    ;;
    'configure ntp')
      configure_ntp
    ;;
    'configure captive portal')
      configure_captive_portal
    ;;
    update)
      update
      exit 0
    ;;
    esac
  }

configure_webview(){
    while true; do
      selector Vanadium Aosmium Cromite
      #TODO:: add array logic
      CURRENT_SELECTION=""
      echo "install additional webiew?"
      echo "Vol + = Yes, Vol - = No"
      if ! chooseport; then
        return
      fi
    done
    WEBVIEW_UPDATE=true
  }

configure_private_dns(){
    selector Mullvad Quad9 Cloudflare custom
    case $CURRENT_SELECTION in
    Mullvad)
      sed -i.bak 's/^PRIVATE_DNS=.*/PRIVATE_DNS=adblock.dns.mullvad.net/' $config
      CURRENT_SELECTION=""
    ;;
    Quad9)
      sed -i.bak 's/^PRIVATE_DNS=.*/PRIVATE_DNS=dns.quad9.net/' $config
      CURRENT_SELECTION=""
    ;;
    Cloudflare)
      sed -i.bak 's/^PRIVATE_DNS=.*/PRIVATE_DNS=one.one.one.one/' $config
      CURRENT_SELECTION=""
    ;;
    custom)
      #TODO:create action for entering text
      echo "for custom entries, edit the line PRIVATE_DNS in /data/adb/moduels/DeGoogleProps/settings.conf..."
    ;;
    esac
  }

configure_ntp(){
    selector pool.ntp.org custom
    if [[CURRENT_SELECTION == pool.ntp.org]]; then
      sed -i.bak 's/^NTP_SERVER=.*/NTP_SERVER=pool.ntp.org/' $config 
      CURRENT_SELECTION="" 
      return 0
    fi
    echo "custom entries are not yet supported in configurator :("
    echo "for custom entries, edit the lines CAPTIVE_PORTAL_HTTP_URL and CAPTIVE_PORTAL_HTTPS_URL in /data/adb/moduels/DeGoogleProps/settings.conf..."
  }
configure_captive_portal(){
    selector GrapheneOS /e/OS Kuketz custom off
    case CURRENT_SELECTION in
    GrapheneOS)
      sed -i.bak 's/^CAPTIVE_PORTAL_ENABLED=.*/CAPTIVE_PORTAL_ENABLED=1/' $config
      sed -i.bak 's/^CAPTIVE_PORTAL_HTTP_URL=.*/CAPTIVE_PORTAL_HTTP_URL=http://connectivitycheck.grapheneos.network/' $config
      sed -i.bak 's/^CAPTIVE_PORTAL_HTTPS_URL=.*/CAPTIVE_PORTAL_HTTPS_URL=https://connectivitycheck.grapheneos.network/' $config
      CURRENT_SELECTION=""
    ;;
    /e/OS)
      sed -i.bak 's/^CAPTIVE_PORTAL_ENABLED=.*/CAPTIVE_PORTAL_ENABLED=1/' $config
      sed -i.bak 's/^CAPTIVE_PORTAL_HTTP_URL=.*/CAPTIVE_PORTAL_HTTP_URL=http://204.ecloud.global/' $config
      sed -i.bak 's/^CAPTIVE_PORTAL_HTTPS_URL=.*/CAPTIVE_PORTAL_HTTPS_URL=https://e.foundation/net_204/' $config
      CURRENT_SELECTION=""
    ;;
    Kuketz)
      sed -i.bak 's/^CAPTIVE_PORTAL_ENABLED=.*/CAPTIVE_PORTAL_ENABLED=1/' $config
      sed -i.bak 's/^CAPTIVE_PORTAL_HTTP_URL=.*/CAPTIVE_PORTAL_HTTP_URL=http://captiveportal.kuketz.de/' $config
      sed -i.bak 's/^CAPTIVE_PORTAL_HTTPS_URL=.*/CAPTIVE_PORTAL_HTTPS_URL=https://captiveportal.kuketz.de/' $config
      CURRENT_SELECTION=""
    ;;
    custom)
      echo "custom entries are not yet supported in configurator :("
      echo "for custom entries, edit the lines CAPTIVE_PORTAL_HTTP_URL and CAPTIVE_PORTAL_HTTPS_URL in /data/adb/moduels/DeGoogleProps/settings.conf..."
    ;;
    off)
      sed -i.bak 's/^CAPTIVE_PORTAL_ENABLED=.*/CAPTIVE_PORTAL_ENABLED=1/' $config
      CURRENT_SELECTION=""
    ;;
    esac
  }

#TUI controls for select options
clear_screen() { printf "\033[2J\033[H"; }
hide_cursor() { printf "\033[?25l"; }
show_cursor() { printf "\033[?25h"; }
reset() { printf "\033[0m"; }

# selelction function for choices passed on as positional arguments (options in order)
selector() {
  local opts=("$@")
  local n=${#opts[@]}
  local idx=0
  CURRENT_SELECTION=""
  hide_cursor
  while true; do
    # draw menu
    clear_screen
    echo "Use Volume Up to select, Volume Down to cancel."
    echo
    for i in "${!opts[@]}"; do
      if [ "$i" -eq "$idx" ]; then
        printf "  \033[1m➜ %s\033[0m\n" "${opts[i]}"
      else
        printf "    %s\n" "${opts[i]}"
      fi
    done

    # wait for volume key
    if chooseport 1; then
      # Volume Up: select current item
      CURRENT_SELECTION="${opts[idx]}"
      show_cursor
      return 0
    else
      # Volume Down: move to next option (cycle)
      idx=$(( (idx + 1) % n ))
    fi
  done
}

# chooseport funtion using volume keys 
chooseport() {
  local delay=${1:-1}
  local tmp=$TMPDIR/events
  while true; do
    timeout "$delay" /system/bin/getevent -lqc 1 2>&1 > "$tmp" &
    sleep 0.1
    if grep -q 'KEY_VOLUMEUP *DOWN' "$tmp"; then
      return 0
    elif grep -q 'KEY_VOLUMEDOWN *DOWN' "$tmp"; then
      return 1
    fi
    # keep looping until key pressed
  done
}

update(){
    if WEBVIEW_UPDATE; then
      echo "Installing or Updating Webview(s)..."
      source settings.conf
      if [[ "${#WEBVIEW[@]}" == 3 ]]; then
        [ -f "$MODDIR/common/install.sh" ] && . "$MODDIR/common/install.sh" "all"
      else
        for i in "${arr[WEBVIEW]}"; do
          [ -f "$MODDIR/common/install.sh" ] && . "$MODDIR/common/install.sh" "$i"
        done
      fi
    fi
    echo "Applying values..."
    . $MODDIR/service.sh
  }

#======================================
#this is where the functions get called
#=====================================
configuration_type
update

